{
  "name": "dicta-action-js",
  "version": "0.1.1",
  "description": "Browser element that runs a user request on your web site. It asks dicta-action-server for a plan and runs it with the functions of your site.",
  "keywords": [
    "natural-language",
    "ai-agent",
    "llm",
    "web-components",
    "custom-elements",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrahcom/dicta-action-js.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "prettier --check . && tsc",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "node --test --test-timeout=5000 \"test/**/*.test.ts\"",
    "test:browser": "npm run build && playwright test",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
